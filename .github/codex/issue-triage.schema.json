{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "category": {
      "type": "string",
      "enum": ["bug", "feature", "question", "support", "documentation", "unknown"]
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "disposition": {
      "type": "string",
      "enum": ["actionable", "needs-logs", "needs-information", "product-decision"]
    },
    "summary": {"type": "string", "maxLength": 280},
    "confirmed_facts": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "maxLength": 240}
    },
    "likely_causes": {
      "type": "array",
      "maxItems": 2,
      "items": {"type": "string", "maxLength": 450}
    },
    "related_issues": {
      "type": "array",
      "maxItems": 2,
      "items": {"type": "string", "maxLength": 240}
    },
    "missing_information": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "maxLength": 240}
    },
    "recommended_next_steps": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "maxLength": 300}
    },
    "needs_human": {"type": "boolean"},
    "human_reason": {"type": "string", "maxLength": 300}
  },
  "required": [
    "category",
    "priority",
    "confidence",
    "disposition",
    "summary",
    "confirmed_facts",
    "likely_causes",
    "related_issues",
    "missing_information",
    "recommended_next_steps",
    "needs_human",
    "human_reason"
  ]
}
